  "WreckItRalph_TheForgotten/TheForgotten_SEC_Forg_050_SEC_Forg_050_TalkTo01.locbin": [
    {
      "key": "TheForgotten_000_f",
      "en": "That was weird. Where'd it go?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "TheForgotten_003_f",
      "en": "And what does it mean?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_000_f",
      "en": "Another Villager trying to return the Valley.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_001_f",
      "en": "Pie and root beer? I don't remember any games like that.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_002_f",
      "en": "No idea. This place is one weird thing after another.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "TheForgotten_004_f",
      "en": "I—",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "TheForgotten_007_f",
      "en": "Oh. Really? That's... great...",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_f",
      "en": "You okay?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_000_f",
      "en": "You seem upset about something.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_001_f",
      "en": "Want to help me find where the hungry arcade machine went?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_002_f",
      "en": "Now YOU'RE acting weird.",
      "cz": "",
      "source": "untranslated"
    },
