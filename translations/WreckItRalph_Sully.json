{
  "WreckItRalph_Sully/Sully_VLG_Ralp_010_VLG_Ralp_010_TalkTo08.locbin": [
    {
      "key": "Sully_000_f",
      "en": "Hi, Sulley.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_000_f",
      "en": "Did you lose a patch of fur?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_001_f",
      "en": "Snuck into Ralph's House lately?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_000_choice_002_f",
      "en": "Tell me where the Do-Gooder Trophy is!",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_003_f",
      "en": "Huh? Nope. As a matter of fact, I switched to a new shampoo. Keeps hairballs away. Mike's always complaining they clog up the shower.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_004_f",
      "en": "What's this about?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_f",
      "en": "A special trophy was stolen from Ralph's House. I found a clump of blue fur nearby.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_000_f",
      "en": "You won't be in trouble if you did it.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_001_f",
      "en": "I'm just trying to find the truth.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Player_001_choice_002_f",
      "en": "CONFESS, BLUE BOY!",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_005_f",
      "en": "Blue fur, huh?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_006_f",
      "en": "Have you talked to Stitch?",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_007_f",
      "en": "Not to point paws, but that little guy seems to get into lots of trouble. Might be worth askin'.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_010_f",
      "en": "Stitch? Why didn't I think of that?! I'm really sorry, Sulley!",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_011_f",
      "en": "No problem. Good luck!",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_008_f",
      "en": "Whoa, take it easy, {PlayerName}.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_009_f",
      "en": "I've never even been inside Ralph's House.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_001_f",
      "en": "Ralph? Can't say that I have.",
      "cz": "",
      "source": "untranslated"
    },
    {
      "key": "Sully_002_f",
      "en": "The what?",
      "cz": "",
      "source": "untranslated"
    }
  ]
}