<Window x:Class="TranslationManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TranslationManager.ViewModels"
        xmlns:conv="clr-namespace:TranslationManager.Converters"
        Title="DDV Translation Manager – Český překlad Disney Dreamlight Valley"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:SourceToColorConverter x:Key="SourceToColor"/>
        <conv:SourceToLabelConverter x:Key="SourceToLabel"/>
        <conv:IsModifiedToBackgroundConverter x:Key="ModifiedToBg"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Menu + Stats -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📂 Načíst JSON složku" Style="{StaticResource AccentButton}" 
                            Command="{Binding LoadJsonDirectoryCommand}" Margin="0,0,4,0"/>
                    <Button Content="📦 Načíst ZIP ze hry" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding LoadZipFileCommand}" Margin="0,0,16,0"/>
                    <Button Content="💾 Uložit změny" Style="{StaticResource AccentButton}" 
                            Command="{Binding SaveToJsonCommand}" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Title -->
                <TextBlock Grid.Column="1" Text="DDV Translation Manager" 
                           Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextDimBrush}" Margin="8,0">
                        <Run Text="Celkem: "/><Run Text="{Binding TotalEntries}" FontWeight="Bold" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextDimBrush}" Margin="8,0">
                        <Run Text="Přeloženo: "/><Run Text="{Binding TranslatedEntries}" FontWeight="Bold" Foreground="#4CAF50"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextDimBrush}" Margin="8,0">
                        <Run Text="Vylepšeno: "/><Run Text="{Binding ImprovedEntries}" FontWeight="Bold" Foreground="#2196F3"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Categories -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📁 Kategorie" Foreground="{StaticResource TextBrush}" 
                               FontWeight="SemiBold" FontSize="14" Margin="4,4,4,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" 
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Medium" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Foreground="#9E9E9E" FontSize="11">
                                            <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" textů"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#FFC107" FontSize="11" Margin="8,0,0,0" 
                                                   Visibility="{Binding LongDialogCount, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{Binding LongDialogCount, Mode=OneWay}"/><Run Text=" k revizi"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource SelectedColor}"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" Background="Transparent" HorizontalAlignment="Stretch"/>

            <!-- CENTER: Translation grid -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,8">
                        <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,8,0" Tag="🔍 Hledat..."/>
                        <CheckBox Content="Pouze původní" IsChecked="{Binding ShowOnlyPreExisting}" Margin="8,0"/>
                        <CheckBox Content="Delší dialogy" IsChecked="{Binding ShowOnlyLongDialogs}" Margin="8,0"/>
                        <CheckBox Content="Nepřeložené" IsChecked="{Binding ShowOnlyUntranslated}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,8">
                        <Button Content="➕ Přidat do dávky" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding AddToBatchCommand}"/>
                        <Button Content="📋 Přidat stránku" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding AddPageToBatchCommand}"/>
                        <TextBlock Text="Velikost dávky:" Foreground="{StaticResource TextDimBrush}" 
                                   VerticalAlignment="Center" Margin="12,0,4,0" FontSize="12"/>
                        <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="40" VerticalAlignment="Center" 
                                 Background="#2A2A3A" Foreground="White" BorderBrush="#555" 
                                 Padding="4,2" FontSize="12"/>
                        <TextBlock Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12">
                            <Run Text="V dávce: "/><Run Text="{Binding BatchCount, Mode=OneWay}" 
                                                        FontWeight="Bold" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Data grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DisplayedEntries}" 
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" Foreground="White"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2A2A3E"
                              RowBackground="#1E1E2E" AlternatingRowBackground="#252538"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              FontSize="12.5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource BorderColor}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource BorderColor}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stav" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Source, Converter={StaticResource SourceToColor}}" 
                                                CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Source, Converter={StaticResource SourceToLabel}}" 
                                                       Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="EN – Anglický originál" Binding="{Binding EnglishText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Foreground" Value="#B0BEC5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CZ – Český překlad" Binding="{Binding CzechText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Vylepšený" Binding="{Binding ImprovedCzechText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Foreground" Value="#64B5F6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.2"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" Background="Transparent" HorizontalAlignment="Stretch"/>

            <!-- RIGHT: Batch panel -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Batch header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="🤖 AI Dávkový překlad" Foreground="White" FontWeight="SemiBold" FontSize="14" 
                                   Margin="4,4,4,4"/>
                        <TextBlock Text="1. Přidejte texty do dávky → 2. Vygenerujte → 3. Vložte do AI chatu → 4. Importujte odpověď" 
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,4,8" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="4,0,4,4">
                            <Button Content="📤 Vygenerovat dávku" Style="{StaticResource AccentButton}" 
                                    Command="{Binding GenerateBatchCommand}"/>
                            <Button Content="🗑 Vyčistit" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ClearBatchCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Batch output (to copy) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 Výstup pro AI (zkopírujte do chatu):" Foreground="{StaticResource TextDimBrush}" 
                                   FontSize="11" Margin="4,4"/>
                        <TextBox Grid.Row="1" Text="{Binding BatchOutput}" IsReadOnly="True" 
                                 TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                 FontFamily="Consolas" Margin="4"/>
                    </Grid>

                    <!-- Separator -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="4,8"/>

                    <!-- Batch input (paste AI response) -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4">
                            <TextBlock Text="📥 Odpověď z AI (vložte sem):" Foreground="{StaticResource TextDimBrush}" 
                                       FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="📋 Vložit" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding PasteFromClipboardCommand}" Margin="8,0,0,0"
                                    Padding="8,4" FontSize="11"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding BatchInput, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                 FontFamily="Consolas" Margin="4"/>
                    </Grid>

                    <!-- Import button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,8,4,4">
                        <Button Content="⬇ Importovat překlady" Style="{StaticResource AccentButton}" 
                                Command="{Binding ImportBatchCommand}"/>
                        <Button Content="✅ Schválit vše" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding ApproveAllCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM: Status bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12,6" 
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           VerticalAlignment="Center"/>
                <!-- Loading spinner -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⏳ Načítám..." Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


